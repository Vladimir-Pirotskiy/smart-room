{
  "title": "Smart Room lights",
  "rules": [
    {
      "description": "[SmartRoom] F13-F19 = lights: F13 on/off, F14/F15 dimmer/brighter, F16/F17 previous/next mood, F18 Day, F19 Dream; Clear = number pad: digits <-> lights",
      "manipulators": [
        {
          "type": "basic",
          "description": "F13 -> lights on/off",
          "from": {
            "key_code": "f13",
            "modifiers": {
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "l",
              "modifiers": [
                "left_control",
                "left_option",
                "left_command"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "description": "F14 -> dimmer",
          "from": {
            "key_code": "f14",
            "modifiers": {
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "hyphen",
              "modifiers": [
                "left_control",
                "left_option",
                "left_command"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "description": "F15 -> brighter",
          "from": {
            "key_code": "f15",
            "modifiers": {
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "equal_sign",
              "modifiers": [
                "left_control",
                "left_option",
                "left_command"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "description": "F16 -> previous mood",
          "from": {
            "key_code": "f16",
            "modifiers": {
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "open_bracket",
              "modifiers": [
                "left_control",
                "left_option",
                "left_command"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "description": "F17 -> next mood",
          "from": {
            "key_code": "f17",
            "modifiers": {
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "close_bracket",
              "modifiers": [
                "left_control",
                "left_option",
                "left_command"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "description": "F18 -> Day",
          "from": {
            "key_code": "f18",
            "modifiers": {
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "1",
              "modifiers": [
                "left_control",
                "left_option",
                "left_command"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "description": "F19 -> Dream",
          "from": {
            "key_code": "f19",
            "modifiers": {
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "6",
              "modifiers": [
                "left_control",
                "left_option",
                "left_command"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "description": "Clear -> number pad switches between digits and lights",
          "from": {
            "key_code": "keypad_num_lock",
            "modifiers": {
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "0",
              "modifiers": [
                "left_control",
                "left_option",
                "left_command"
              ]
            }
          ]
        }
      ]
    }
  ]
}
